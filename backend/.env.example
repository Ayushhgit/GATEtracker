# GATE Tracker Backend Configuration

# App Settings
APP_NAME=GATE Tracker
DEBUG=false

# Database (SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./gate_tracker.db

# Authentication
USER_PIN=123456
USER_EMAIL=gate_aspirant@local
SECRET_KEY=your-super-secret-key-min-32-characters-long-change-this

# Token expiry (30 days in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Groq API
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-70b-versatile

# CORS (for production, replace with your frontend URL)
BACKEND_CORS_ORIGINS=["*"]
